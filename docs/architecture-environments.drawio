<mxfile host="app.diagrams.net">
  <diagram id="environments" name="environments">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="params" value="One template: infra/workload/main.bicep (+ infra/main.bicep for the spoke)&#xa;Environment differences are parameter values only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ptest" value="main.test.bicepparam&#xa;(workload + spoke)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pprod" value="main.prod.bicepparam&#xa;(workload + spoke)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="Hub VNet vnet-hub (rg-platform, swedencentral)&#xa;192.168.100.0/24&#xa;Linked to the TEST SQL Private DNS zone only&#xa;(a VNet can link one zone per namespace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="260" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="test" value="rg-hotelbooking-test-plc (polandcentral)&#xa;Spoke vnet-hotelbooking-test-polandcentral-001 — 10.21.0.0/16&#xa;snet-private-endpoints 10.21.0.0/24 | snet-containerapps 10.21.1.0/24&#xa;Container Apps: 0–3 replicas, scale to zero, not zone redundant&#xa;SQL serverless GP_S_Gen5 (1 vCore), auto-pause 60 min, not zone redundant&#xa;Own Private DNS zone (linked to spoke + hub)&#xa;Own runtime identity + frontend FQDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="prod" value="rg-hotelbooking-prod-plc (polandcentral)&#xa;Spoke vnet-hotelbooking-prod-polandcentral-001 — 10.22.0.0/16&#xa;snet-private-endpoints 10.22.0.0/24 | snet-containerapps 10.22.1.0/24&#xa;Container Apps: 3–6 replicas, no scale to zero, zone redundant&#xa;SQL zone-redundant, no auto-pause&#xa;Own Private DNS zone (linked to spoke only)&#xa;Own runtime identity + frontend FQDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="440" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note" value="No peering between test and prod spokes" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="670" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="params" target="ptest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="params" target="pprod"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="peer-hub-to-hotelbooking-test-plc / peer-hotelbooking-test-plc-to-hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;startArrow=classic;" edge="1" parent="1" source="hub" target="test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="peer-hub-to-hotelbooking-prod-plc / peer-hotelbooking-prod-plc-to-hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;startArrow=classic;" edge="1" parent="1" source="hub" target="prod"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="deploys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="ptest" target="test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="deploys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="pprod" target="prod"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
